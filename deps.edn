{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). Both
 ;; live in the kotoba-lang org of this workspace. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates. langchain is pinned here
 ;; directly (not only under :dev) so a bare `kbb -M:test` works
 ;; offline inside the monorepo checkout without depending on
 ;; langgraph's own transitive git/sha pin being fetchable.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  ;; (kept for parity with sibling actors' deps.edn shape; redundant
  ;; with the top-level :deps override above).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "printpressmfg.sim"]}
  ;; kbb -M:dev:render-html [out-file]
  ;;   -> drive the REAL actor stack (operation -> governor -> phase ->
  ;;      store) and render docs/samples/operator-console.html from its
  ;;      actual output. Deterministic: two runs are byte-identical.
  ;;      Throws if the run produced no governor HOLD (see
  ;;      `printpressmfg.render-html/-main`) -- a console depicting an
  ;;      ungoverned actor is a build failure, not a warning.
  :render-html {:main-opts ["-m" "printpressmfg.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; OPT-IN 3D render verification for `printpressmfg.scene`:
  ;;   kbb -M:visualize
  ;; Deliberately isolated from :test -- `io.github.kotoba-lang/webgpu`
  ;; drags kami-engine's transitive rendering graph in, and this repo's
  ;; governance/actuation path must never depend on it. `src/
  ;; printpressmfg/scene.cljc` is itself dependency-free and merely
  ;; CONFORMS to the documented render-IR shape; this alias is the only
  ;; place the real renderer is on the classpath. Same isolation the
  ;; sibling isic-2813 repo uses (ADR-2800000100).
  ;; Requires Node + a Playwright Chromium install reachable via
  ;; NODE_PATH or the npx cache -- `npx playwright install chromium`.
  :visualize
  {:extra-paths ["test-visualize"]
   :extra-deps {io.github.kotoba-lang/webgpu {:local/root "../../kotoba-lang/webgpu"}
                io.github.kotoba-lang/playwright {:local/root "../../kotoba-lang/playwright"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   ;; kotoba-lang/physics-2d pins io.github.kotoba-lang/physics by git/sha while
   ;; webgpu's own transitive graph uses :local/root -- tools.deps can't compare
   ;; a :git and a :local/root coordinate for the same lib, so force the
   ;; workspace-local checkout (same pattern as this file's :dev override-deps).
   :override-deps {io.github.kotoba-lang/physics {:local/root "../../kotoba-lang/physics"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-visualize"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test-visualize"]}}

  ;; OPT-IN lattice-Boltzmann purge-flow solve for `printpressmfg.cfd`:
  ;;   kbb -M:cfd
  ;; `src/printpressmfg/cfd.cljk` holds the problem DEFINITION and the
  ;; pure post-processing and is dependency-free; this alias is the only
  ;; place the actual solver (`kami-cfd`, zero-dep portable CLJC) is on
  ;; the classpath, so a bare `kbb -M:test` never needs a CFD solver.
  ;; Same isolation rationale as :visualize above.
  :cfd
  {:extra-paths ["test-cfd"]
   :extra-deps {io.github.kotoba-lang/kami-engine-cfd
                {:local/root "../../kotoba-lang/kami-engine-cfd"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-cfd"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test-cfd"]}}

  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  ;; The alias-gated dirs are linted too: they are .cljc, so a JVM-only
  ;; interop slip (e.g. `Double/isNaN`) would otherwise go unnoticed
  ;; until someone ran them on another runtime.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test" "test-cfd" "test-visualize"
                        "--fail-level" "error"]}}}
