;; Scoped bb.edn for the open-robo clj port (ADR-2606280030).
;; Does NOT touch the repo-root bb.edn. No external deps: this is a pure-stdlib
;; port (clojure.set + java.lang.Math only), so it loads on a bare babashka.
{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}}
 :tasks
 {test {:doc "Run the clojure.test suite under babashka"
        :task (shell "bb" "run_tests.clj")}}}
